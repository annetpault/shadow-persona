{
  "manifest_version": 3,
  "name": "Shadow Persona",
  "version": "1.0",
  "description": "Privacy-first form automation, synthetic persona generator, disposable mailbox, and local encrypted vault",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.1secmail.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}